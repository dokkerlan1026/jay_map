      <IconStyle>
        <color>ff2020dd</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- 樣式3: 非 488 店家 (橙色圖標) -->
    <Style id="style-diff-orange">
      <IconStyle>
        <color>ff1e60e6</color>
        <scale>1.25</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href>
        </Icon>
      </IconStyle>
    </Style>

